    },
    {
      "id": "iKBoN2p5cLOboViVm5osQ",
      "type": "text",
      "x": 1921.738703680923,
      "y": 1273.4688142316345,
      "width": 647.4716796875,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
