    {
      "id": "ZqP2A_xO9rJal2YLBhJ-7",
      "type": "text",
      "x": 1923.627652386521,
      "y": 1587.0342993608858,
      "width": 558.7117919921875,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
