      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The agent will repeat this until it has enough information to give \na final answer. \n\nObserve -> Reason -> Tool -> Observe -> .... -> Answer",
      "autoResize": true,
      "lineHeight": 1.25
    },
